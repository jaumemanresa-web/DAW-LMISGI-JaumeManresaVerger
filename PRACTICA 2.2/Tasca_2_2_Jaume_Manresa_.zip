</head>

<body>

    <!-- Capçalera de la pàgina -->
    <header>
        <h1>Botigues d'informàtica</h1>
    </header>

    <!-- Introducció -->
    <p>
        Les botigues d'informàtica venen ordinadors, components
        i accessoris per estudiar, treballar o jugar.
    </p>

    <!-- Tipus de productes -->
    <h2>Productes informàtics</h2>

    <ul>
        <li>Ordinadors i portàtils</li>
        <li>Targetes gràfiques i processadors</li>
        <li>Teclats, ratolins i monitors</li>
    </ul>

    <!-- Imatge d'un ordinador -->
    <h2>Ordinadors i components</h2>

    <img src="ComponentsACTIVITAT2.2.png" alt="Ordinador i components informàtics" width="300">

    <!-- Taula amb informació de les botigues -->
    <h2>Algunes botigues d'informàtica</h2>

    <table>
        <tr>
            <th>Botiga</th>
            <th>Productes</th>
        </tr>
        <tr>
            <td>Amazon</td>
            <td>Informàtica i electrònica</td>
        </tr>
        <tr>
            <td>PcComponentes</td>
            <td>Ordinadors i components</td>
        </tr>
        <tr>
            <td>Coolmod</td>
            <td>Components i equips gaming</td>
        </tr>
    </table>

    <!-- Enllaços a les botigues -->
    <h2>Enllaços d'interès</h2>

    <ul>
        <li><a href="https://www.amazon.es/">Amazon</a></li>
        <li><a href="https://www.pccomponentes.com/">PcComponentes</a></li>
